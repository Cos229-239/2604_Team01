<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Main title for the Create Campaign screen -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:minWidth="488dp"
        android:maxWidth="488dp"
        android:text="@string/create_new_campaign"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <!-- Input field for campaign name -->
    <EditText
        android:id="@+id/et_campaign_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:minWidth="488dp"
        android:maxWidth="488dp"
        android:hint="@string/campaign_name"
        android:inputType="textCapWords"
        android:autofillHints="campaignName"
        android:minHeight="56dp"
        android:layout_marginBottom="16dp"/>

    <!-- Input field for campaign description -->
    <EditText
        android:id="@+id/et_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:minWidth="488dp"
        android:maxWidth="488dp"
        android:hint="@string/description_optional"
        android:inputType="textMultiLine"
        android:autofillHints="description"
        android:minLines="4"
        android:gravity="top|start"
        android:minHeight="120dp"
        android:layout_marginBottom="32dp"/>

    <!-- Button to create the campaign -->
    <Button
        android:id="@+id/btn_create_campaign"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:minWidth="280dp"
        android:maxWidth="320dp"
        android:layout_gravity="center_horizontal"
        android:text="@string/create_campaign"/>

</LinearLayout>