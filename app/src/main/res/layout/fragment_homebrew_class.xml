<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <!-- Main Title -->
    <TextView
        android:id="@+id/tvClassCreate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create a Class"
        android:textSize="30sp"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        app:layout_constraintTop_toTopof="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="HardcodedText,MissingConstraints" />

    <!-- Text View for the name -->
    <TextView
        android:id="@+id/tvClassName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Give your Class a Name: "
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tvClassCreate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"
        tools:ignore="HardcodedText" />

    <!-- Fill in the name in this text editor -->
    <EditText
        android:id="@+id/etClassName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:inputType="textPersonName"
        app:layout_constraintStart_toEndOf="@id/tvClassName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvClassName"
        app:layout_constraintBottom_toBottomOf="@id/tvClassName"
        android:layout_marginStart="8dp"
        tools:ignore="Autofill,LabelFor" />

    <!-- Text Editor for general description -->
    <EditText
        android:id="@+id/etClassDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="Write a description here."
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tvClassName"
        tools:ignore="Autofill,HardcodedText,MissingConstraints,TextFields" />

</androidx.constraintlayout.widget.ConstraintLayout>