<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Dialog Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_player_to_campaign"
        android:textSize="20sp"
        android:textStyle="bold"
        android:maxWidth="488dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"/>

    <!-- Input field for player username or ID -->
    <EditText
        android:id="@+id/et_player_username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="@string/username_or_user_id"
        android:inputType="text"
        android:autofillHints="username"
        android:minHeight="56dp"
        android:minWidth="280dp"
        android:maxWidth="488dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"/>

    <!-- Action Buttons (Cancel + Add) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:layout_marginEnd="8dp"
            style="?android:attr/buttonBarButtonStyle"/>

        <Button
            android:id="@+id/btn_add_player"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_player"
            style="?android:attr/buttonBarButtonStyle"/>

    </LinearLayout>
</LinearLayout>